PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=MONGO_URI=mongodb+srv://zaalimaproject_db_user:zaalima%40123@cluster0.trajix2.mongodb.net/zaalimadb?retryWrites=true&w=majority

# JWT
