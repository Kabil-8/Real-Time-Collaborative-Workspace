# REDIS_TTL_MEMBERS=600
# REDIS_TTL_LISTS=300

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:3000

# Invite token expiry (hours)
INVITE_TOKEN_EXPIRES_HOURS=48
